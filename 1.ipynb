%pip install py3Dmol
import py3Dmol

# 1. Leer el archivo .xyz local en modo texto
with open("aor.xyz", "r") as f:
    xyz_data = f.read()

# 2. Inicializar el visor interactivo de py3Dmol
view = py3Dmol.view(width=600, height=400)

# 3. Cargar el modelo pasando el texto y el formato 'xyz'
view.addModel(xyz_data, "xyz")

# 4. Configurar el estilo visual (ej. esferas y varillas)
view.setStyle({'stick': {}, 'sphere': {'scale': 0.3}})

# 5. Ajustar la cámara automáticamente
view.zoomTo()

# 6. Mostrar el widget (Obligatorio en Jupyter)
view.show()
